# Type signatures for the public API of the langsys-rails gem.

module Langsys
  module Rails
    VERSION: String

    def self.configure: () ?{ (Config) -> void } -> Config
    def self.config: () -> Config
    def self.client: () -> untyped
    def self.client=: (untyped) -> untyped
    def self.reset_client!: () -> void
    def self.t: (String, ?String?, **untyped) -> String
    def self.locale: () -> String

    class Config
      # Settings the base SDK's client defines, passed to it unchanged.
      CORE_SETTINGS: Array[Symbol]
      # Where Rails keeps the values SRV-6's locale resolution reads.
      WIRING_SETTINGS: Array[Symbol]

      attr_accessor api_key: String?
      attr_accessor project_id: String?
      attr_accessor api_url: String?
      attr_accessor base_locale: String?
      attr_accessor cache: untyped
      attr_accessor cache_ttl: Integer?
      attr_accessor timeout: Float?
      attr_accessor auto_flush: bool
      attr_accessor logger: untyped
      attr_accessor messages_category: String?
      attr_accessor migration: Array[String]?
      attr_accessor migration_locale: String?
      attr_accessor snapshot: String?
      attr_accessor query_param: String
      attr_accessor cookie_name: String
      attr_accessor cookie_max_age: Integer
      def initialize: () -> void
      def core_options: () -> Hash[Symbol, untyped]
    end

    # Backed by ActiveSupport::CurrentAttributes (reset per request by Rails).
    class CurrentLocale
      def self.locale: () -> String?
      def self.locale=: (String?) -> String?
    end

    class CurrentAttributesLocaleSource
      def get: () -> String
      def subscribe: (?untyped) ?{ (String) -> void } -> Proc
    end

    # Rack middleware marking the request boundary: drops the base SDK's write decision as a
    # request enters, and flushes discovered phrases once the response has been sent.
    class RequestBoundary
      def initialize: (untyped app) -> void
      def call: (Hash[String, untyped] env) -> [ Integer, untyped, untyped ]
    end

    module Helper
      def ls: (String, ?String?, **untyped) -> String
      def ls_message: (Hash[String, untyped]) -> String
      def langsys_resolved_attributes: () -> Hash[String, String]
    end

    # ActiveModel validation failures as server-message entries (MSG-1..11).
    module Messages
      def self.entries: (untyped errors, ?client: untyped) -> Array[Hash[String, untyped]]
      def self.wording: (untyped error) -> [ String, String, Hash[String, untyped]? ]
      def self.templates_for: (Symbol type, String label, Symbol kind) -> Array[String]
    end

    # MSG-7's source for an ActiveModel app's validators.
    class ValidatorSource
      attr_reader name: String
      def initialize: (?Array[Class]? classes) -> void
      def collect: (untyped catalog) -> untyped
    end

    # Legacy-key migration's I18n.t entry point (MIG-2, MIG-8).
    class I18nBridge
      def self.install!: () -> void
      attr_reader backend: untyped
      def initialize: (untyped backend) -> void
      def translate: (Symbol | String locale, untyped key, ?Hash[Symbol, untyped] options) -> untyped
    end

    module Controller
      include Helper
    end
  end
end
